{
  "name": "ayagaidi/libya-dev-api",
  "type": "project",
  "description": "Open developer API for Libya: locations, phone normalization, telecom metadata and reusable Libyan developer utilities.",
  "keywords": ["libya", "laravel", "api", "open-data", "phone-validation", "telecom", "municipalities", "cities"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"],
    "test": "@php artisan test",
    "lint": "pint --test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
