{
  "openapi": "3.1.0",
  "info": {
    "title": "Libya Dev API",
    "version": "0.4.0",
    "description": "Open developer API for Libya. All endpoints are language-agnostic HTTP/JSON interfaces."
  },
  "servers": [{"url": "/api/v1", "description": "Current host"}],
  "tags": [
    {"name": "Meta"}, {"name": "Locations"}, {"name": "Geo"}, {"name": "Phone"},
    {"name": "Telecom"}, {"name": "Banks"}, {"name": "Holidays"},
    {"name": "Exchange Rates"}, {"name": "Calendar"}
  ],
  "paths": {
    "/meta": {"get": {"tags":["Meta"],"summary":"API and Libya metadata","responses":{"200":{"description":"OK"}}}},
    "/locations/municipalities": {"get": {"tags":["Locations"],"summary":"List Libyan municipalities","parameters":[{"name":"q","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Municipality collection"},"503":{"description":"Pinned source unavailable"}}}},
    "/locations/municipalities/{slug}": {"get": {"tags":["Locations"],"summary":"Get municipality by stable slug","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Municipality"},"404":{"description":"Not found"}}}},
    "/locations/cities": {"get": {"tags":["Locations"],"summary":"List Libyan cities/places","parameters":[{"name":"q","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"City collection"}}}},
    "/geo/municipality-points": {"get": {"tags":["Geo"],"summary":"List municipality reference points from pinned Libya Locations data","parameters":[{"name":"mapped_only","in":"query","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Point collection with coverage metadata"},"503":{"description":"Pinned source unavailable"}}}},
    "/geo/municipalities.geojson": {"get": {"tags":["Geo"],"summary":"Get municipality reference points as GeoJSON","responses":{"200":{"description":"GeoJSON FeatureCollection","content":{"application/geo+json":{}}},"503":{"description":"Pinned source unavailable"}}}},
    "/geo/nearest": {"get": {"tags":["Geo"],"summary":"Find nearest mapped municipalities using Haversine distance","parameters":[{"name":"lat","in":"query","required":true,"schema":{"type":"number","minimum":-90,"maximum":90}},{"name":"lng","in":"query","required":true,"schema":{"type":"number","minimum":-180,"maximum":180}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":50,"default":5}}],"responses":{"200":{"description":"Nearest municipalities"},"422":{"description":"Invalid coordinates"}}}},
    "/geo/nearby": {"get": {"tags":["Geo"],"summary":"Find mapped municipalities within a radius","parameters":[{"name":"lat","in":"query","required":true,"schema":{"type":"number","minimum":-90,"maximum":90}},{"name":"lng","in":"query","required":true,"schema":{"type":"number","minimum":-180,"maximum":180}},{"name":"radius_km","in":"query","schema":{"type":"number","minimum":0.1,"maximum":1000,"default":50}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":50,"default":20}}],"responses":{"200":{"description":"Nearby municipalities"},"422":{"description":"Invalid query"}}}},
    "/phone/normalize": {"post": {"tags":["Phone"],"summary":"Normalize a Libyan mobile number","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PhoneInput"}}}},"responses":{"200":{"description":"Normalized number"},"422":{"description":"Validation error"}}}},
    "/phone/validate": {"post": {"tags":["Phone"],"summary":"Validate and identify a known Libyan mobile number range","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PhoneInput"}}}},"responses":{"200":{"description":"Validation result"}}}},
    "/telecom/operators": {"get": {"tags":["Telecom"],"summary":"List mobile operator prefix metadata and sources","responses":{"200":{"description":"Operators"}}}},
    "/banks": {"get": {"tags":["Banks"],"summary":"List commercial banks from the Central Bank of Libya directory","parameters":[{"name":"q","in":"query","schema":{"type":"string"}},{"name":"city","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Bank collection"}}}},
    "/banks/{slug}": {"get": {"tags":["Banks"],"summary":"Get a bank by stable slug","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Bank"},"404":{"description":"Not found"}}}},
    "/holidays": {"get": {"tags":["Holidays"],"summary":"Get the Libya holiday calendar for the current Tripoli year","responses":{"200":{"description":"Holiday calendar"}}}},
    "/holidays/{year}": {"get": {"tags":["Holidays"],"summary":"Get the Libya holiday calendar for a year","parameters":[{"name":"year","in":"path","required":true,"schema":{"type":"integer","minimum":1900,"maximum":2100}}],"responses":{"200":{"description":"Holiday calendar"},"422":{"description":"Invalid year"}}}},
    "/exchange-rates": {"get": {"tags":["Exchange Rates"],"summary":"Get current official Central Bank of Libya exchange rates","responses":{"200":{"description":"CBL exchange-rate collection"},"503":{"description":"CBL source unavailable"}}}},
    "/exchange-rates/{currency}": {"get": {"tags":["Exchange Rates"],"summary":"Get one CBL exchange-rate record by ISO currency code","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","minLength":3,"maxLength":3}}],"responses":{"200":{"description":"Exchange rate"},"404":{"description":"Currency not mapped"}}}},
    "/currency/convert": {"post": {"tags":["Exchange Rates"],"summary":"Convert between LYD and supported CBL currencies","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CurrencyConversionInput"}}}},"responses":{"200":{"description":"Conversion result"},"422":{"description":"Validation error"}}}},
    "/calendar/is-business-day": {"get": {"tags":["Calendar"],"summary":"Check whether a date is a general Libya public-sector business day","parameters":[{"name":"date","in":"query","required":true,"schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"Business-day analysis"}}}},
    "/calendar/next-business-day": {"get": {"tags":["Calendar"],"summary":"Find the next general Libya public-sector business day after a date","parameters":[{"name":"date","in":"query","required":true,"schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"Next business day"}}}},
    "/calendar/business-days": {"get": {"tags":["Calendar"],"summary":"List business days in an inclusive range up to 366 days","parameters":[{"name":"from","in":"query","required":true,"schema":{"type":"string","format":"date"}},{"name":"to","in":"query","required":true,"schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"Business-day range"}}}}
  },
  "components": {
    "schemas": {
      "PhoneInput": {"type":"object","required":["phone"],"properties":{"phone":{"type":"string","examples":["0912345678","+218912345678"]}}},
      "CurrencyConversionInput": {"type":"object","required":["amount","from","to"],"properties":{"amount":{"type":"number","minimum":0},"from":{"type":"string"},"to":{"type":"string"},"rate_type":{"type":"string","enum":["average","buy","sell"],"default":"average"}}}
    }
  }
}
